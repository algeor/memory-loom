{
  "$defs": {
    "AnalysisConfig": {
      "additionalProperties": false,
      "properties": {
        "h1_decision_rule": {
          "minLength": 1,
          "title": "H1 Decision Rule",
          "type": "string"
        },
        "independent_unit": {
          "enum": [
            "scenario",
            "template_family"
          ],
          "title": "Independent Unit",
          "type": "string"
        },
        "interval_method": {
          "minLength": 1,
          "title": "Interval Method",
          "type": "string"
        },
        "multiplicity_method": {
          "minLength": 1,
          "title": "Multiplicity Method",
          "type": "string"
        },
        "repeat_aggregation": {
          "minLength": 1,
          "title": "Repeat Aggregation",
          "type": "string"
        },
        "scenario_weighting": {
          "minLength": 1,
          "title": "Scenario Weighting",
          "type": "string"
        }
      },
      "required": [
        "repeat_aggregation",
        "scenario_weighting",
        "independent_unit",
        "interval_method",
        "multiplicity_method",
        "h1_decision_rule"
      ],
      "title": "AnalysisConfig",
      "type": "object"
    },
    "DecodingConfig": {
      "additionalProperties": false,
      "properties": {
        "max_output_tokens": {
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "temperature": {
          "maximum": 2,
          "minimum": 0,
          "title": "Temperature",
          "type": "number"
        },
        "top_p": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Top P",
          "type": "number"
        }
      },
      "required": [
        "temperature",
        "top_p",
        "max_output_tokens"
      ],
      "title": "DecodingConfig",
      "type": "object"
    },
    "PromptHashes": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "System",
          "type": "string"
        },
        "user": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "User",
          "type": "string"
        }
      },
      "required": [
        "system",
        "user"
      ],
      "title": "PromptHashes",
      "type": "object"
    }
  },
  "$id": "https://memory-loom.local/schemas/v1/run-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysis": {
      "$ref": "#/$defs/AnalysisConfig"
    },
    "artifact_type": {
      "const": "run_manifest",
      "title": "Artifact Type",
      "type": "string"
    },
    "code_revision": {
      "minLength": 1,
      "title": "Code Revision",
      "type": "string"
    },
    "condition_manifest_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Condition Manifest Id",
      "type": "string"
    },
    "condition_order": {
      "items": {
        "enum": [
          "B0",
          "B1",
          "B2",
          "B3"
        ],
        "type": "string"
      },
      "title": "Condition Order",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_version": {
      "minLength": 1,
      "title": "Dataset Version",
      "type": "string"
    },
    "decoding": {
      "$ref": "#/$defs/DecodingConfig"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "prompt_hashes": {
      "$ref": "#/$defs/PromptHashes"
    },
    "protocol_version": {
      "minLength": 1,
      "title": "Protocol Version",
      "type": "string"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "repeats": {
      "minimum": 1,
      "title": "Repeats",
      "type": "integer"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "scenario_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9._-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Scenario Ids",
      "type": "array"
    },
    "schema_version": {
      "pattern": "^1\\.[0-9]+\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "status": {
      "enum": [
        "prepared",
        "running",
        "completed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "artifact_type",
    "schema_version",
    "run_id",
    "created_at",
    "protocol_version",
    "dataset_version",
    "code_revision",
    "condition_manifest_id",
    "scenario_ids",
    "provider",
    "model",
    "prompt_hashes",
    "condition_order",
    "decoding",
    "seed",
    "repeats",
    "analysis",
    "status"
  ],
  "title": "RunManifest",
  "type": "object"
}
